opt_out_usage

require "dotenv"

local_credentials = File.expand_path(
  "~/.config/timebox-mark/app_store_connect.env"
)
Dotenv.load(local_credentials) if File.file?(local_credentials)

default_platform(:ios)

platform :ios do
  desc "Run local release checks without uploading"
  lane :verify do
    repo_root = File.expand_path("../..", __dir__)
    sh("cd #{repo_root} && flutter gen-l10n")
    sh("cd #{repo_root} && dart run build_runner build")
    sh("cd #{repo_root} && bash scripts/ci/verify_release_guardrails.sh")
  end

  desc "Build a signed App Store Connect IPA"
  lane :build_ipa do |options|
    repo_root = File.expand_path("../..", __dir__)
    verify unless options[:skip_verify]

    build_number = ENV["BUILD_NUMBER"] || Time.now.utc.strftime("%Y%m%d%H")
    sh(
      "cd #{repo_root} && flutter build ipa --release " \
      "--build-number=#{build_number} " \
      "--export-options-plist=ios/ExportOptions.app-store.plist"
    )
  end

  desc "Build and upload to TestFlight"
  lane :internal_beta do
    repo_root = File.expand_path("../..", __dir__)
    build_ipa(skip_verify: false)

    ipa_path = Dir[File.join(repo_root, "build/ios/ipa/*.ipa")].sort.last
    UI.user_error!("No IPA found in build/ios/ipa") unless ipa_path

    upload_to_testflight(
      api_key: app_store_api_key_from_env,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV.fetch(
        "TESTFLIGHT_CHANGELOG",
        "Internal beta build for Timebox Mark."
      )
    )
  end

  desc "Upload App Store metadata and screenshots without a binary"
  lane :metadata do
    deliver(
      api_key: app_store_api_key_from_env,
      skip_binary_upload: true,
      skip_screenshots: false,
      submit_for_review: false
    )
  end

  private_lane :app_store_api_key_from_env do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_filepath = ENV["APP_STORE_CONNECT_KEY_FILEPATH"]
    key_content = ENV["APP_STORE_CONNECT_KEY_CONTENT"]

    if key_id.to_s.empty? || issuer_id.to_s.empty?
      UI.user_error!(
        "Set APP_STORE_CONNECT_KEY_ID and APP_STORE_CONNECT_ISSUER_ID."
      )
    end

    if key_content.to_s.length.positive?
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_content: key_content,
        is_key_content_base64: ENV["APP_STORE_CONNECT_KEY_CONTENT_BASE64"] == "true",
        in_house: false
      )
    elsif key_filepath.to_s.length.positive?
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: key_filepath,
        in_house: false
      )
    else
      UI.user_error!(
        "Set APP_STORE_CONNECT_KEY_FILEPATH or APP_STORE_CONNECT_KEY_CONTENT."
      )
    end
  end
end
