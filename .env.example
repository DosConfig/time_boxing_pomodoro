# Timebox Mark release automation template.
# Copy to .env locally or configure these in Codemagic environment groups.
# Fill every value with your own. Never commit the real .env.

APP_IDENTIFIER=com.example.yourapp
APP_STORE_APP_ID=
APPLE_ID=you@example.com
# Apple Developer Portal Team ID. This is not the App Store Connect login email.
APPLE_TEAM_ID=YOUR_TEAM_ID
# App Store Connect provider/team id shown in App Store Connect.
APP_STORE_CONNECT_TEAM_ID=YOUR_ASC_TEAM_ID

# Prefer App Store Connect API keys over personal Apple ID passwords.
# Local Fastlane runs automatically load the real values from:
# ~/.config/timebox-mark/app_store_connect.env
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_FILEPATH=
APP_STORE_CONNECT_KEY_CONTENT=
APP_STORE_CONNECT_KEY_CONTENT_BASE64=false

# CI-only restoration for files ignored in this public repository.
FIREBASE_OPTIONS_DART_BASE64=
GOOGLE_SERVICE_INFO_PLIST_BASE64=
GOOGLE_SERVICES_JSON_BASE64=
GOOGLE_REVERSED_CLIENT_ID=

# Optional Shorebird patch workflow.
SHOREBIRD_TOKEN=
SHOREBIRD_RELEASE_VERSION=
