{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ],
    "cleanUrls": false
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "flutter": {
    "platforms": {
      "ios": {
        "buildConfigurations": {
          "Debug": {
            "projectId": "timebox-mark-prod",
            "appId": "1:135782331609:ios:2a2f70f4bec6f8ba4dbac8",
            "uploadDebugSymbols": false,
            "fileOutput": "ios/Runner/GoogleService-Info.plist"
          }
        },
        "default": {
          "projectId": "timebox-mark-prod",
          "appId": "1:135782331609:ios:2a2f70f4bec6f8ba4dbac8",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "timebox-mark-prod",
          "configurations": {
            "android": "1:135782331609:android:d685c0b973e701174dbac8",
            "ios": "1:135782331609:ios:2a2f70f4bec6f8ba4dbac8"
          }
        }
      },
      "android": {
        "default": {
          "projectId": "timebox-mark-prod",
          "appId": "1:135782331609:android:d685c0b973e701174dbac8",
          "fileOutput": "android/app/google-services.json"
        }
      }
    }
  }
}
